{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "FlowZero - Flow Watermark Remover",
  "version": "1.3.1",
  "description": "Tiện ích 1-click tự động xóa watermark khi tải hình ảnh và video từ Google Flow (labs.google)",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "assets/icon48.png",
    "default_title": "FlowZero Watermark Remover"
  },
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/*"
      ],
      "js": [
        "scripts/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://labs.google/*"
      ],
      "js": [
        "scripts/interceptor.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "downloads",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://*.googleusercontent.com/*",
    "https://storage.googleapis.com/*",
    "https://flow-content.google/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icon128.png"
      ],
      "matches": [
        "https://labs.google/*"
      ]
    }
  ]
}
