{
  "manifest_version": 3,
  "name": "FlowZero - Flow Image Watermark Remover",
  "version": "1.1.0",
  "description": "Tiện ích 1-click tự động xóa watermark khi tải hình ảnh từ Google Flow (labs.google)",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "assets/icon48.png",
    "default_title": "FlowZero Watermark Remover"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/*"
      ],
      "js": [
        "scripts/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://labs.google/*"
      ],
      "js": [
        "scripts/interceptor.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "downloads",
    "offscreen",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://*.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icon128.png",
        "assets/flow-watermark-alpha-48.png",
        "lib/LocalGeminiWatermarkRemover.js",
        "lib/LocalFlowWatermarkRemover.js",
        "scripts/interceptor.js"
      ],
      "matches": [
        "https://labs.google/*"
      ]
    }
  ]
}
